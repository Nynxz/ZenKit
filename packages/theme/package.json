  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "peerDependencies": {
    "@nynxz/zenkit-client": "workspace:^"
  },
  "devDependencies": {
    "@nynxz/zenkit-client": "workspace:*",
    "vite": "^6.4.3"

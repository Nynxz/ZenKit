{
  "name": "@nynxz/zenkit-theme",
  "version": "0.3.2",
  "type": "module",
  "description": "ZenKit token system — semantic token packs and the applier.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",

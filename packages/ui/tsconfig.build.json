{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": ["src"],
  // theme.ts re-exports a private package; the build emits its declarations into dist/theme
  "exclude": ["src/theme.ts"]
}

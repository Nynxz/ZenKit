{
  "name": "@nynxz/zenkit-ui",
  "version": "0.3.2",
  "type": "module",
  "description": "Shared Vue components for ZenKit, styled over the theme token system.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/zenkit-ui.css",
    "./comfy-bridge.css": "./dist/comfy-bridge.css",
    "./theme": {
      "types": "./dist/theme.d.ts",
      "import": "./dist/theme.js"
    }
  },
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.build.json && tsc -p ../theme/tsconfig.build.json --outDir dist/theme && node -e \"require('fs').writeFileSync('dist/theme.d.ts', \\\"export * from './theme/index'\\n\\\")\"",
    "typecheck": "vue-tsc --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "vue": "^3.5.0",
    "@nynxz/zenkit-client": "workspace:^"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.4",
    "vite": "^6.4.3",
    "@nynxz/zenkit-theme": "workspace:*",
    "@nynxz/zenkit-client": "workspace:*"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nynxz/ZenKit.git",
    "directory": "packages/ui"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependenciesMeta": {
    "@nynxz/zenkit-client": {
      "optional": true
    }
  }
}

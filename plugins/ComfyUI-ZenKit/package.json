{
  "name": "comfyui-zenkit",
  "version": "0.3.2",
  "private": true,
  "type": "module",
  "description": "ComfyUI plugin that serves the ZenKit runtime (window.ZenKit, taskbar) and its built-in panels.",
  "scripts": {
    "build": "vite build && vite build -c vite.runtime.config.mts",
    "dev": "node dev.mjs",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@nynxz/zenkit-client": "workspace:*",
    "@nynxz/zenkit-core": "workspace:*",
    "@nynxz/zenkit-ui": "workspace:*",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.3",
    "vite": "^6.3.5",
    "@nynxz/zenkit-nodekit": "workspace:*"
  }
}
